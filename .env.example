# Cole suas credenciais do Firebase Console (https://console.firebase.google.com)
# Copie este arquivo para ".env" (gitignored) e preencha os valores reais.
# O "firebase-config.js" é gerado automaticamente por: node gerar-firebase-config.js

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=